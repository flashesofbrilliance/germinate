{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flashesofbrilliance/handoff-ledger/spec/manifest.schema.json",
  "title": "handoff-ledger manifest",
  "description": "Registry of every surface (canonical git files + advisory projections) and its sync status.",
  "type": "object",
  "required": ["docsetVersion", "surfaces"],
  "additionalProperties": true,
  "properties": {
    "docsetVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Za-z0-9]+\\.[0-9]+$",
      "description": "Header version: YYYY-MM-DD-<phase>.<n>. Surfaces below this are STALE."
    },
    "canonicalBranch": { "type": "string" },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "required": ["id", "kind", "docset"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["canonical", "projection"] },
        "role": { "type": "string" },
        "docset": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Za-z0-9]+\\.[0-9]+$"
        },
        "path": {
          "type": "string",
          "description": "Required for kind=canonical: the git-tracked file."
        },
        "ref": {
          "type": "string",
          "description": "Required for kind=projection: an opaque out-of-band handle (e.g. gdoc:ID, artifact:UUID, url:…)."
        },
        "source": {
          "type": "array",
          "items": { "type": "string" },
          "description": "For projections: the canonical surface id(s) this is rendered from."
        },
        "status": { "enum": ["IN_SYNC", "OUT_OF_SYNC", "STALE", "MISSING"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "canonical" } } },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "kind": { "const": "projection" } } },
          "then": { "required": ["ref"] }
        }
      ]
    }
  }
}
