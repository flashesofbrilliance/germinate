{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flashesofbrilliance/germinate/spec/belief-log.schema.json",
  "title": "germinate belief-log line",
  "description": "One line of an append-only, OpenTelemetry-shaped belief log (JSONL). Validate each line independently.",
  "type": "object",
  "required": ["ts", "trace", "span", "kind"],
  "additionalProperties": true,
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 event timestamp."
    },
    "trace": {
      "type": "string",
      "minLength": 1,
      "description": "The engagement/topic — one OTel trace."
    },
    "span": {
      "type": "string",
      "minLength": 1,
      "description": "One belief's lifetime — one OTel span. '_meta' is reserved for the trace-open line."
    },
    "kind": {
      "enum": ["trace.open", "belief.open", "belief.update", "belief.close", "note"]
    },
    "phase": { "type": "string" },
    "belief": { "type": "string" },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "trigger": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Residual (adjusted) risk after derisking, 0..1. Paired with confidence: conviction is licensed to rise as risk retires; confidence climbing while risk stays flat is an unearned-optimism signal."
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["OPEN", "ALIGNED", "SUPERSEDED", "DEFERRED", "CLOSED"] },
    "note": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "belief.open" } } },
      "then": { "required": ["belief"] }
    },
    {
      "if": { "properties": { "kind": { "const": "note" } } },
      "then": { "required": ["note"] }
    },
    {
      "if": { "properties": { "kind": { "const": "trace.open" } } },
      "then": { "required": ["note"] }
    }
  ]
}
